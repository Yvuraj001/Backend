//pass  and ref token jwt secret respectively.
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

// Database
MONGODB_URI=mongodb://localhost:27017/Backend


// google oAuth credentials
GOOGLE_CLIENT=
GOOGLE_SECRET=

// none only if frontend and backend on different ports
PORT=3000
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
COOKIE_SAME_SITE=none


// for email service
RESEND_API_KEY=your_resend_api_key
APP_NAME=Backend Services
COMPANY_NAME=Backend Services
SUPPORT_EMAIL=support@example.com
EMAIL_FROM=Backend Services <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3000